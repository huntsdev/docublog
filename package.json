{
  "name": "hunts-dev",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && node scripts/build-worker.mjs",
    "preview": "wrangler dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1",
    "check": "astro check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local --persist-to .wrangler/state",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "astro": "latest",
    "@astrojs/react": "latest",
    "@astrojs/mdx": "latest",
    "@astrojs/sitemap": "latest",
    "@fontsource-variable/geist": "latest",
    "@fontsource-variable/jetbrains-mono": "latest",
    "@radix-ui/react-dialog": "latest",
    "@radix-ui/react-dropdown-menu": "latest",
    "react": "latest",
    "react-dom": "latest",
    "lucide-react": "latest",
    "minisearch": "latest",
    "drizzle-orm": "latest"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest",
    "drizzle-kit": "latest",
    "esbuild": "latest",
    "wrangler": "latest",
    "@playwright/test": "latest"
  }
}
