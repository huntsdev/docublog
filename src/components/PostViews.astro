---
interface Props {
  slug: string;
  track?: boolean;
  collection?: 'blog' | 'projects';
}

const { slug, track = false, collection = 'blog' } = Astro.props;
---

<span
  class="post-views"
  data-view-slug={slug}
  data-view-collection={collection}
  data-view-state="loading"
  data-track-view={track ? 'true' : undefined}
  aria-label="Page views loading"
  title="Page views. Reloads within 30 minutes count once."
>
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M2.1 12a1 1 0 0 1 0-.7 11 11 0 0 1 19.8 0 1 1 0 0 1 0 .7 11 11 0 0 1-19.8 0Z" />
    <circle cx="12" cy="11.7" r="3" />
  </svg>
  <span data-view-count aria-live="polite" aria-atomic="true">— views</span>
</span>

<script>
  import '../scripts/views';
</script>

<style>
  .post-views { display: inline-flex; align-items: center; gap: 0.4rem; white-space: nowrap; }
</style>
