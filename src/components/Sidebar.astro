---
import Icon from './Icon.astro';
import { getPosts, getProjects, socialLinks } from '../lib/content';
const posts = await getPosts();
const projects = await getProjects();
const current = Astro.url.pathname;
---
<aside class="sidebar" id="site-sidebar" aria-label="Main navigation" tabindex="-1">
  <div class="mobile-sidebar-heading"><span>Explore hunts.dev</span><button class="icon-button" data-close-menu aria-label="Close navigation"><Icon name="close" /></button></div>
  <div class="sidebar-controls">
    <span class="sidebar-controls-label">Navigation</span>
    <button type="button" class="icon-button sidebar-toggle" data-toggle-sidebar aria-label="Collapse sidebar" title="Collapse sidebar" aria-controls="site-sidebar" aria-expanded="true"><Icon name="panel-left" size={18} class="sidebar-toggle-icon" /></button>
  </div>
  <nav class="sidebar-nav">
    <a class:list={['nav-item', 'overview-link', { active: current === '/' }]} href="/" aria-label="Overview" title="Overview" aria-current={current === '/' ? 'page' : undefined}><Icon name="home" /><span class="sidebar-label">Overview</span></a>
    <div class="nav-section">
      <details open data-sidebar-section="blog">
        <summary class:list={['nav-section-title', { active: current.startsWith('/blog/') }]} aria-label="Blog Posts" title="Blog Posts" aria-expanded="true"><span><Icon name="file" /><span class="sidebar-label">Blog Posts</span></span><Icon name="chevron" size={14} class="nav-section-chevron" /></summary>
        <div class="nav-section-content"><div class="nav-section-body">
          <a class:list={['nav-item', { active: current === '/blog/' }]} href="/blog/" aria-current={current === '/blog/' ? 'page' : undefined}><span>All posts</span></a>
          {posts.map(post => <a href={`/blog/${post.id}/`} title={post.data.title} class:list={['nav-item', 'child-item', { active: current === `/blog/${post.id}/` }]} aria-current={current === `/blog/${post.id}/` ? 'page' : undefined}>{post.data.title}</a>)}
        </div></div>
      </details>
    </div>
    <div class="nav-section">
      <details open data-sidebar-section="projects">
        <summary class:list={['nav-section-title', { active: current.startsWith('/projects/') }]} aria-label="Projects" title="Projects" aria-expanded="true"><span><Icon name="folder" /><span class="sidebar-label">Projects</span></span><Icon name="chevron" size={14} class="nav-section-chevron" /></summary>
        <div class="nav-section-content"><div class="nav-section-body">
          <a class:list={['nav-item', { active: current === '/projects/' }]} href="/projects/" aria-current={current === '/projects/' ? 'page' : undefined}>All projects</a>
          {projects.map(project => <a href={`/projects/${project.id}/`} title={project.data.title} class:list={['nav-item', 'child-item', { active: current === `/projects/${project.id}/` }]} aria-current={current === `/projects/${project.id}/` ? 'page' : undefined}>{project.data.title}</a>)}
        </div></div>
      </details>
    </div>
    <a class:list={['nav-item', 'about-link', { active: current === '/about/' }]} href="/about/" aria-label="About" title="About" aria-current={current === '/about/' ? 'page' : undefined}><Icon name="user" /><span class="sidebar-label">About</span></a>
    <div class="sidebar-divider"></div>
    <div class="nav-label">ON THE WEB</div>
    {socialLinks.map(link => <a class="nav-item social-link" href={link.href} target="_blank" rel="noopener noreferrer" aria-label={link.title} title={link.title}><Icon name={link.icon} size={17} /><span class="sidebar-label">{link.title}</span><Icon name="arrow" size={13} class="sidebar-external-icon" /></a>)}
  </nav>
  <div class="sidebar-footer"><div class="sidebar-footer-copy"><div class="sidebar-note"><span class="status-dot"></span> A growing collection</div><p>Stay curious. Keep building.</p></div><a class="sidebar-rss" href="/rss.xml" aria-label="Subscribe via RSS" title="Subscribe via RSS"><Icon name="rss" size={17} /><span class="sidebar-label">Subscribe via RSS</span><Icon name="arrow" size={12} class="sidebar-external-icon" /></a></div>
</aside>
<button class="sidebar-scrim" data-close-menu aria-label="Close navigation" tabindex="-1"></button>

<script is:inline>
  (() => {
    try {
      const sections = JSON.parse(localStorage.getItem('hunts-sidebar-sections') || '{}');
      document.querySelectorAll('[data-sidebar-section]').forEach(section => {
        const open = sections?.[section.dataset.sidebarSection];
        if (typeof open === 'boolean') section.open = open;
        section.querySelector('summary').setAttribute('aria-expanded', String(section.open));
      });
    } catch {}
  })();
</script>
