---
import { calloutIcon, calloutVariants } from '../../lib/callouts.mjs';
interface Props {
  variant?: 'info' | 'warning' | 'danger' | 'note' | 'tip';
  title?: string;
}

const { variant = 'note', title } = Astro.props;
if (!Object.prototype.hasOwnProperty.call(calloutVariants, variant)) {
  throw new Error('[Callout] variant must be "info", "warning", "danger", "note", or "tip".');
}
const { label } = calloutVariants[variant];
---

<aside class="callout" data-variant={variant} role="note" aria-label={title ? `${label}: ${title}` : label}>
  <p class="callout-title"><Fragment set:html={calloutIcon(variant)} /><span>{title || label}</span></p>
  <div class="callout-body"><slot /></div>
</aside>
