---
interface Props {
  variant?: 'note' | 'tip' | 'warning';
  title?: string;
}

const { variant = 'note', title } = Astro.props;
const labels = { note: 'Note', tip: 'Tip', warning: 'Warning' };
if (!Object.prototype.hasOwnProperty.call(labels, variant)) {
  throw new Error('[Callout] variant must be "note", "tip", or "warning".');
}
const label = labels[variant];
---

<aside class="callout" data-variant={variant} role="note" aria-label={title ? `${label}: ${title}` : label}>
  <svg class="callout-icon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    {variant === 'warning' ? <><path d="m10.3 3.9-8 14a2 2 0 0 0 1.7 3h16a2 2 0 0 0 1.7-3l-8-14a2 2 0 0 0-3.4 0Z" /><path d="M12 9v4m0 4h.01" /></> : variant === 'tip' ? <><path d="M9 18h6m-5 3h4M8 14a6 6 0 1 1 8 0c-.8.7-1 1.5-1 2H9c0-.5-.2-1.3-1-2Z" /></> : <><circle cx="12" cy="12" r="9" /><path d="M12 11v6m0-10h.01" /></>}
  </svg>
  <div class="callout-content">
    <p class="callout-title">{title || label}</p>
    <div class="callout-body"><slot /></div>
  </div>
</aside>

<style>
  .callout { display: flex; align-items: flex-start; gap: .8rem; margin: 1.65rem 0; padding: 1.05rem 1.15rem; border: 1px solid var(--border); border-left: 3px solid var(--accent); border-radius: var(--radius); background: var(--surface); color: var(--text); }
  .callout[data-variant="tip"] { background: var(--accent-soft); }
  .callout[data-variant="warning"] { border-left-color: var(--text); }
  .callout-icon { flex-shrink: 0; margin-top: .13rem; color: var(--accent); }
  .callout[data-variant="warning"] .callout-icon { color: var(--text); }
  .callout-content { min-width: 0; }
  .callout-title { margin: 0 0 .35rem; color: var(--text); font-size: .875rem; font-weight: 600; line-height: 1.5; }
  .callout-body { color: var(--muted); font-size: .875rem; line-height: 1.8; }
  .callout-body > :global(:first-child) { margin-top: 0; }
  .callout-body > :global(:last-child) { margin-bottom: 0; }
</style>
