---
import '@fontsource-variable/geist';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import '../styles/search.css';
import '../styles/theme.css';
import SearchDialog from '../components/SearchDialog';
import ThemeToggle from '../components/ThemeToggle';
import Sidebar from '../components/Sidebar.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Icon from '../components/Icon.astro';
import { DEFAULT_AUTHOR, getAuthorProfile } from '../lib/authors';
interface Props {
  title?: string;
  description?: string;
  section?: string;
  headings?: { depth?: number; slug: string; text: string }[];
  home?: boolean;
  noindex?: boolean;
  image?: string;
  article?: boolean;
  publishedAt?: Date;
  articleTags?: string[];
  author?: string;
}
const { title = 'A working collection of things worth knowing', description = 'Practical notes on engineering, security, and building things. A personal knowledge base by hunts.dev.', section = 'Overview', headings = [], home = false, noindex = false, image, article = false, publishedAt, articleTags = [], author = DEFAULT_AUTHOR } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ownerProfile = getAuthorProfile(DEFAULT_AUTHOR);
const authorProfile = getAuthorProfile(author);
const socialImage = new URL(image || ownerProfile.image!, Astro.site);
const articleMetadata = article ? JSON.stringify({
  '@context': 'https://schema.org', '@type': 'BlogPosting',
  headline: title, description, image: socialImage.href, mainEntityOfPage: canonical.href,
  datePublished: publishedAt?.toISOString(),
  author: { '@type': 'Person', name: author, url: authorProfile.url && new URL(authorProfile.url, Astro.site).href, image: authorProfile.image && new URL(authorProfile.image, Astro.site).href },
}).replace(/</g, '\\u003c') : undefined;
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · hunts.dev</title>
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <meta name="theme-color" content="#f4f4f0" />
    <meta property="og:title" content={`${title} · hunts.dev`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={image ? title : 'hunts.dev'} />
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:image" content={socialImage} />
    {article && publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {article && articleTags.map(tag => <meta property="article:tag" content={tag} />)}
    {articleMetadata && <script type="application/ld+json" set:html={articleMetadata} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico?v=ryan-hunt" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=ryan-hunt" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=ryan-hunt" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=ryan-hunt" />
    <link rel="manifest" href="/site.webmanifest?v=ryan-hunt" />
    <link rel="alternate" type="application/rss+xml" title="hunts.dev Blog" href="/rss.xml" />
    <script is:inline>
      (() => {
        let theme = 'system';
        try { theme = localStorage.getItem('hunts-theme') || 'system'; } catch {}
        const dark = theme === 'dark' || (theme === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>
  </head>
  <body id="top">
    <a href="#main-content" class="skip-link">Skip to content</a>
    <header class="site-header">
      <div class="header-brand"><button class="icon-button menu-trigger" data-open-menu aria-label="Open navigation" aria-controls="site-sidebar" aria-expanded="false"><Icon name="menu" size={20} /></button><a href="/" aria-label="hunts.dev home"><img src={ownerProfile.avatar} alt="" width="36" height="36" /><span>hunts<span class="brand-dot">.</span>dev</span></a></div>
      <div class="header-content"><span class="header-caption">my personal knowledge base<span class="caption-dot">.</span></span><div class="header-actions"><SearchDialog client:load /><span class="header-divider"></span><ThemeToggle client:load /><a href="https://github.com/huntsdev" class="header-github icon-button" aria-label="huntsdev on GitHub" target="_blank" rel="noopener noreferrer"><Icon name="github" size={20} /></a></div></div>
    </header>
    <Sidebar />
    <div class="main-shell">
      <main class:list={['page-content', { 'home-content': home }]} id="main-content">
        <div class="breadcrumb"><a href="/"><Icon name="home" size={14} /></a><Icon name="right" size={12} />{section !== 'Overview' && Astro.url.pathname !== `/${section === 'Blog Posts' ? 'blog' : section.toLowerCase()}/` ? <><a href={`/${section === 'Blog Posts' ? 'blog' : section.toLowerCase()}/`}>{section}</a><Icon name="right" size={12} /><span>{title}</span></> : <span>{section}</span>}</div>
        <slot />
        <footer class="page-footer"><span>© {new Date().getFullYear()} hunts.dev</span><span>Built with curiosity<span class="footer-dot">.</span></span></footer>
      </main>
      <TableOfContents headings={headings} home={home} />
    </div>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
