---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
---
<SiteLayout title="Page not found" noindex>
  <div class="not-found"><div class="eyebrow">404 · UNCHARTED TERRITORY</div><h1>This trail ends here<span class="title-dot">.</span></h1><p>The page may have moved, or the link may be a little off.<br />Try a search, or head back to familiar ground.</p><img class="not-found-image" src="/images/error-404-not.jpg" width="600" height="732" alt="A cartoon dog sits in a burning room above the words Error 404 Not Found." /><div><a href="/" class="button-primary">Back to overview <Icon name="right" size={15} /></a><button class="button-secondary" data-open-search><Icon name="search" size={15} />Search the site</button></div></div>
</SiteLayout>
