---
import { render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getPosts, readingTime } from '../../lib/content';
export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({ params: { slug: post.id }, props: { post, previous: posts[i - 1], next: posts[i + 1] } }));
}
const { post, previous, next } = Astro.props;
const { Content, headings } = await render(post);
---
<ArticleLayout title={post.data.title} description={post.data.description} section="Blog Posts" headings={headings} date={post.data.date} tags={post.data.tags} readingTime={readingTime(post.body)} slug={post.id} previous={previous && {title:previous.data.title,url:`/blog/${previous.id}/`}} next={next && {title:next.data.title,url:`/blog/${next.id}/`}}>
  <Content />
</ArticleLayout>
