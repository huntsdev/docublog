---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import PostRow from '../components/PostRow.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getPosts, getProjects } from '../lib/content';
const posts = await getPosts();
const projects = await getProjects();
---
<SiteLayout home>
  <section class="writing-section" id="latest-writing">
    <div class="section-heading"><h2><span class="section-marker"></span>Latest writing</h2><a href="/blog/">View all posts <Icon name="right" size={13} /></a></div>
    <p class="section-description">the latest and greatest</p>
    <div class="post-list">{posts.slice(0, 4).map(post => <PostRow post={post} />)}</div>
  </section>
  <section id="selected-projects" class="projects-section">
    <div class="section-heading"><h2><span class="section-marker"></span>Selected projects</h2><a href="/projects/">All projects <Icon name="right" size={13} /></a></div>
    <p class="section-description"></p>
    <div class="project-grid">{projects.slice(0, 2).map(project => <ProjectCard project={project} compact />)}</div>
  </section>
  <div class="search-callout"><span class="search-callout-icon"><Icon name="search" size={24} /></span><div><h3>Looking for anything specific?</h3><p>Use the search to find topics that may interest you.</p></div><button class="button-secondary" data-open-search>Find something <span>⌘ K</span></button></div>
</SiteLayout>
